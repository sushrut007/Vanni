/* Vaani — light theme (settings + onboarding) */
QDialog#VaaniSettingsRoot,
QWidget#VaaniOnboardingRoot {
    background-color: #f4f5f7;
    color: #1a1d21;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel#vaaniSettingsTitle,
QLabel#vaaniOnboardingTitle {
    font-size: 20px;
    font-weight: 600;
    color: #111318;
}

QLabel#vaaniSettingsSubtitle,
QLabel#vaaniOnboardingSubtitle,
QLabel#vaaniStepIndicator,
QLabel.vaaniSettingsHint,
QLabel.vaaniOnboardingBody {
    color: #5c6470;
    font-size: 12px;
}

QFrame.vaaniSettingsSection {
    background-color: #ffffff;
    border: 1px solid #e2e5ea;
    border-radius: 10px;
}

QLabel.vaaniSectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #3d434d;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

QComboBox, QLineEdit, #vaaniHotkeyCapture {
    background-color: #f9fafb;
    border: 1px solid #cfd4dc;
    border-radius: 8px;
    padding: 8px 10px;
    min-height: 20px;
}

QComboBox:hover, #vaaniHotkeyCapture:hover {
    border-color: #9aa3b0;
}

QComboBox:focus, #vaaniHotkeyCapture:focus {
    border-color: #3b6fd9;
}

#vaaniHotkeyCapture[capturing="true"] {
    border-color: #3b6fd9;
    background-color: #eef4ff;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #b8c0cc;
    background: #fff;
}

QCheckBox::indicator:checked {
    background: #3b6fd9;
    border-color: #3b6fd9;
}

QLabel#vaaniRefusalLabel {
    color: #b42318;
    font-size: 12px;
}

QPushButton#vaaniPrimaryButton {
    background-color: #3b6fd9;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 9px 22px;
    font-weight: 600;
}

QPushButton#vaaniPrimaryButton:hover {
    background-color: #2f5bb5;
}

QPushButton#vaaniSecondaryButton {
    background-color: transparent;
    color: #3d434d;
    border: 1px solid #cfd4dc;
    border-radius: 8px;
    padding: 9px 16px;
}

QPushButton#vaaniSecondaryButton:hover {
    background-color: #eef0f3;
}

QLabel#vaaniOnboardingPageTitle {
    font-size: 17px;
    font-weight: 600;
    color: #111318;
}

QFrame#vaaniOnboardingCard {
    background-color: #ffffff;
    border: 1px solid #e2e5ea;
    border-radius: 12px;
}

QProgressBar {
    background-color: #e8ebf0;
    border: none;
    border-radius: 6px;
    min-height: 10px;
    text-align: center;
    color: #5c6470;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #3b6fd9;
    border-radius: 6px;
}

QScrollArea#VaaniSettingsScroll,
QWidget#VaaniSettingsContent {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c5cad3;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}